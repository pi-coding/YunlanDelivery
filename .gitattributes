# 管理端 dist 是压缩后的产物，禁止任何换行符转换，否则可能破坏文件
yunlan-backend/yunlan-server/src/main/resources/static/** -text

# 源码统一按文本处理，入库时转 LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf

# 图片等二进制
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
